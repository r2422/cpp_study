[
    {
        "chapter": "はじめに",
        "items": [
            { 
                "title": "使い方", 
                "content": [
                    { "desc": "このサイトは、Gitの基本コマンドの教科書です。\n左の目次から各項目へジャンプできます。" }
                ],
                "note": "「Copy」ボタンを押すとクリップボードに保存されます。" 
            }
        ]
    },
    {
        "chapter": "準備",
        "items": [
            { 
                "title": "初期化 (init)", 
                "content": [
                    { "desc": "フォルダをGit管理下に置きます。" },
                    { "cmd": "git init" }
                ]
            },
            { 
                "title": "ユーザー設定", 
                "content": [
                    { "desc": "初回のみ実行。名前とメールを登録します。" },
                    { "cmd": "git config --global user.name \"Name\"\ngit config --global user.email \"email@example.com\"" }
                ]
            }
        ]
    },
    {
        "chapter": "基本操作",
        "items": [
            { 
                "content": [
                    { "desc": "更新を加える際は「基本操作」と「GitHub連携」を行えばOKです。" }
                ]
            },
            { 
                "title": "追加 (add)", 
                "content": [
                    { "desc": "変更をステージ（セーブ準備エリア）に上げます。" },
                    { "cmd": "git add ." }
                ]
            },
            { 
                "title": "保存 (commit)", 
                "content": [
                    { "desc": "今の状態をローカルに記録します。" },
                    { "cmd": "git commit -m \"接頭辞: 作業メモ\"" },
                    { "desc": "\"作業メモ\"には接頭辞をつけるとわかりやすくなります。" },
                    { 
                        "table": {
                            "headers": ["接頭辞", "意味", "説明"],
                            "rows": [
                                ["feat:", "feature", "新項目や機能の追加"],
                                ["fix:", "fix", "間違い、バグの修正"],
                                ["docs:", "documentation", "説明文の追加"],
                                ["style:", "style", "デザインやコードの整頓"],
                                ["refactor:", "refactor", "コードの清書(機能は維持)"]
                            ]
                        }
                    }
                ]
            }
        ]
    },
    {
        "chapter": "GitHub連携",
        "items": [
            { 
                "title": "送信 (push)", 
                "content": [
                    { "desc": "ローカルの変更をGitHubへ送ります。" },
                    { "cmd": "git push origin main" },
                    { "desc": "変更後はGithubに訪れて確認しましょう。\nF5キーで更新できます。" }
                ]
            },
            { 
                "title": "受信 (pull)", 
                "content": [
                    { "desc": "GitHubの最新版をPCに取り込みます。" },
                    { "cmd": "git pull origin main" }
                ]
            }
        ]
    },
    {
        "chapter": "救急箱",
        "items": [
            { 
                "title": "変更の取消 (restore)", 
                "content": [
                    { "desc": "保存前の変更を捨てて元に戻します。" },
                    { "cmd": "git restore ファイル名" }
                ]
            },
            { 
                "title": "履歴確認 (log)", 
                "content": [
                    { "desc": "これまでのセーブ履歴を一覧表示します。" },
                    { "cmd": "git log --oneline" }
                ]
            }
        ]
    },
    {
        "chapter": "ブランチ",
        "items": [
            { 
                "title": "ブランチの作成 (branch)", 
                "content": [
                    { "desc": "現在の状態から新しい枝（ブランチ）を作ります。" },
                    { "cmd": "git branch ブランチ名" }
                ]
            },
            { 
                "title": "切り替え (switch)", 
                "content": [
                    { "desc": "作業する枝を切り替えます。" },
                    { "cmd": "git switch ブランチ名" }
                ]
            },
            {
                "title": "ブランチ関連コマンド",
                "content": [
                    { "desc": "よく使うブランチ操作のまとめです。" },
                    {
                        "table": {
                            "headers": ["コマンド", "説明"],
                            "rows": [
                                ["git branch", "ブランチの一覧を表示する"],
                                ["git branch -d 名", "指定したブランチを削除する"],
                                ["git merge 名", "別のブランチの変更を取り込む"]
                            ]
                        }
                    }
                ]
            }
        ]
    }
]