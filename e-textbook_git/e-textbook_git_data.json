[
    {
        "chapter": "はじめに",
        "items": [
            { 
                "title": "使い方", 
                "content": [
                    { "desc": "このサイトは、Gitの基本コマンドの教科書です。\n左の目次から各項目へジャンプできます。" }
                ],
                "note": "「Copy」ボタンを押すとクリップボードに保存されます。" 
            }
        ]
    },
    {
        "chapter": "準備",
        "items": [
            { 
                "title": "初期化 (init)", 
                "content": [
                    { "desc": "フォルダをGit管理下に置きます。" },
                    { "cmd": "git init" }
                ]
            },
            { 
                "title": "ユーザー設定", 
                "content": [
                    { "desc": "初回のみ実行。名前とメールを登録します。" },
                    { "cmd": "git config --global user.name \"Name\"\ngit config --global user.email \"email@example.com\"" }
                ]
            }
        ]
    },
    {
        "chapter": "基本操作",
        "items": [
            {
                "title": "ディレクトリの移動 (cd)",
                "content": [
                    { "desc": "作業したいフォルダ（ディレクトリ）に移動します。\nドライブが変わる場合は「/d」オプションを付けます。" },
                    { "cmd": "cd /d [フォルダのパス]" },
                    { "desc": "例: cd /d C:\\dev\\cpp_study" }
                ]
            },
            {
                "title": "現在の状態を確認 (status)",
                "content": [
                    { "desc": "「今、どのファイルを編集したか」「addし忘れているファイルはないか」を確認します。" },
                    { "cmd": "git status" },
                    { "desc": "こまめに実行することで、作業のミスを減らすことができます。" }
                ]
            },
            { 
                 "note": "更新を加える際はadd,commitとpush,pullを行えばOKです。" 
            },
            { 
                "title": "追加 (add)", 
                "content": [
                    { "desc": "変更をステージ（セーブ準備エリア）に上げます。" },
                    { "cmd": "git add ." }
                ]
            },
            { 
                "title": "保存 (commit)", 
                "content": [
                    { "desc": "今の状態をローカルに記録します。" },
                    { "cmd": "git commit -m \"接頭辞: 作業メモ\"" },
                    { "desc": "\"作業メモ\"には接頭辞をつけるとわかりやすくなります。" },
                    { 
                        "table": {
                            "headers": ["接頭辞", "意味", "説明"],
                            "rows": [
                                ["feat:", "feature", "新項目や機能の追加"],
                                ["fix:", "fix", "間違い、バグの修正"],
                                ["docs:", "documentation", "説明文の追加"],
                                ["style:", "style", "デザインやコードの整頓"],
                                ["refactor:", "refactor", "コードの清書(機能は維持)"]
                            ]
                        }
                    }
                ]
            }
        ]
    },
    {
        "chapter": "GitHub連携",
        "items": [
            { 
                "title": "送信 (push)", 
                "content": [
                    { "desc": "ローカルの変更をGitHubへ送ります。" },
                    { "cmd": "git push origin main" },
                    { "desc": "変更後はGithubに訪れて確認しましょう。\nF5キーで更新できます。" }
                ]
            },
            { 
                "title": "受信 (pull)", 
                "content": [
                    { "desc": "GitHubの最新版をPCに取り込みます。" },
                    { "cmd": "git pull origin main" }
                ]
            }
        ]
    },
    {
        "chapter": "GitHub連携（応用）",
        "items": [
            { 
                "title": "リモートの登録", 
                "content": [
                    { "desc": "PC上のリポジトリとGitHubのリポジトリを紐付けます。" },
                    { "cmd": "git remote add origin https://github.com/ユーザー名/リポジトリ名.git" }
                ]
            },
            {
                "title": "クローン (clone)",
                "content": [
                    { "desc": "GitHubにある既存のプロジェクトを丸ごとPCにコピーします。" },
                    { "cmd": "git clone URL" }
                ]
            }
        ]
    },
    {
        "chapter": "トラブル解決",
        "items": [
            { 
                "title": "コンフリクトとは？", 
                "content": [
                    { "desc": "同じファイルの同じ行を、自分と他の人が同時に書き換えて push/pull しようとすると「衝突（コンフリクト）」が発生します。" },
                    { "desc": "この場合、Gitが自動で合体できないため、手動でどちらのコードを残すか決める必要があります。" }
                ]
            },
            {
                "title": "直前のコミットメッセージを直す",
                "content": [
                    { "desc": "「メッセージを打ち間違えた！」という時に、最新のコミットだけ書き換えます。" },
                    { "cmd": "git commit --amend -m \"新しいメッセージ\"" }
                ]
            }
        ]
    },
    {
        "chapter": "便利な一覧表",
        "items": [
            {
                "title": "ファイルの状態一覧",
                "content": [
                    { "desc": "git status を実行した時に表示される状態の解説です。" },
                    {
                        "table": {
                            "headers": ["状態", "説明"],
                            "rows": [
                                ["Untracked", "新しく作られた、まだGitが知らないファイル"],
                                ["Modified", "変更されたけれど、まだステージに乗っていないファイル"],
                                ["Staged", "add 済みで、次に commit される準備ができたファイル"],
                                ["Unmodified", "commit 済みで、変更がないファイル"]
                            ]
                        }
                    }
                ]
            }
        ]
    },
    {
        "chapter": "救急箱",
        "items": [
            { 
                "title": "変更の取消 (restore)", 
                "content": [
                    { "desc": "保存前の変更を捨てて元に戻します。" },
                    { "cmd": "git restore ファイル名" }
                ]
            },
            { 
                "title": "履歴確認 (log)", 
                "content": [
                    { "desc": "これまでのセーブ履歴を一覧表示します。" },
                    { "cmd": "git log --oneline" }
                ]
            },
            { 
                "title": "Git管理の解除（初期化のやり直し）", 
                "content": [
                    { "desc": "現在のフォルダにあるGitの設定（履歴など）をすべて削除します。\nコマンドプロンプトで「最初からやり直したい」時に使います。" },
                    { "cmd": "rd /s /q .git" },
                    { "desc": "※実行すると、これまでのコミット履歴が完全に消えるので注意してください。" }
                ]
            }
        ]
    },
    {
        "chapter": "ブランチ",
        "items": [
            { 
                "title": "ブランチの作成 (branch)", 
                "content": [
                    { "desc": "現在の状態から新しい枝（ブランチ）を作ります。" },
                    { "cmd": "git branch ブランチ名" }
                ]
            },
            { 
                "title": "切り替え (switch)", 
                "content": [
                    { "desc": "作業する枝を切り替えます。" },
                    { "cmd": "git switch ブランチ名" }
                ]
            },
            {
                "title": "ブランチ関連コマンド",
                "content": [
                    { "desc": "よく使うブランチ操作のまとめです。" },
                    {
                        "table": {
                            "headers": ["コマンド", "説明"],
                            "rows": [
                                ["git branch", "ブランチの一覧を表示する"],
                                ["git branch -d 名", "指定したブランチを削除する"],
                                ["git merge 名", "別のブランチの変更を取り込む"]
                            ]
                        }
                    }
                ]
            }
        ]
    },
    {
        "chapter": "教科書の修正・更新について",
        "items": [
            { 
                "content": [
                    { "desc": "このサイトはJSON(e-textbook_git_data.json)でデータを管理しています。データを更新する際には以下の形式で変更を行ってください。" },
                    { "cmd": "[ \n    { \n    \"chapter\": \"①\", \n    \"items\": [\n         { \n        \"title\": \"②\", \n        \"content\": [ { \"desc\": \"③\" } ], \n        \"note\": \"⓪\" \n        } \n    ] \n    } \n]" }
                ],
                "note": "titleが自動でidに変換されます。\n表も挿入することができます。" 
            }
        ]
    }
]